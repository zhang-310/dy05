<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot 默认日志配置文件 -->
    <!-- 引入 Spring Boot 默认的配置片段 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 定义属性 -->
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH:-${LOG_TEMP:-${java.io.tmpdir:-/tmp}}/}spring.log}"/>
    <property name="LOG_DIR" value="logs"/>
    <property name="LOG_FILE_MAX_SIZE" value="10MB"/>
    <property name="LOG_FILE_MAX_HISTORY" value="30"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_CHARSET" value="UTF-8"/>

    <!-- Spring Profiles -->
    <springProfile name="dev,local">
        <!-- Development: Console Appender -->
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>${LOG_CHARSET}</charset>
            </encoder>
        </appender>

        <!-- Development: File Appender with Rolling Policy -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/application.log</file>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>${LOG_CHARSET}</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
                <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            </rollingPolicy>
        </appender>

        <!-- Audit Log Appender (for audit trail) -->
        <appender name="AUDIT_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/audit.log</file>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>${LOG_CHARSET}</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/audit-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
                <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            </rollingPolicy>
        </appender>

        <!-- Performance Log Appender -->
        <appender name="PERFORMANCE_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/performance.log</file>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>${LOG_CHARSET}</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/performance-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
                <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            </rollingPolicy>
        </appender>

        <!-- Async Appender for better performance -->
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="FILE"/>
        </appender>

        <!-- Async Audit Log Appender -->
        <appender name="ASYNC_AUDIT" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="AUDIT_LOG"/>
        </appender>

        <!-- Async Performance Log Appender -->
        <appender name="ASYNC_PERFORMANCE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="PERFORMANCE_LOG"/>
        </appender>

        <!-- Logger configuration -->
        <!-- Audit logger -->
        <logger name="cn.gaifan.douyinOperations.common.aspect.AuditLogAspect" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_AUDIT"/>
        </logger>

        <!-- Performance logger -->
        <logger name="cn.gaifan.douyinOperations.common.aspect.PerformanceLogAspect" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_PERFORMANCE"/>
        </logger>

        <!-- Application loggers：dev 默认 INFO，减少 DEBUG 刷屏；需排错时可临时改为 DEBUG -->
        <logger name="cn.gaifan.douyinOperations" level="INFO"/>
        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.springframework.data" level="INFO"/>
        <logger name="org.hibernate" level="INFO"/>

        <!-- Root logger -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_FILE"/>
        </root>
    </springProfile>

    <!-- Production Profile -->
    <springProfile name="prod">
        <!-- Production: File Appender with Rolling Policy (no console output) -->
        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/application.log</file>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
                <charset>${LOG_CHARSET}</charset>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/application-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
                <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
                <totalSizeCap>1GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!-- Production: JSON File Appender for log aggregation (Logstash/ELK) -->
        <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/application-json.log</file>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <charset>${LOG_CHARSET}</charset>
                <customFields>{"service": "douyin-operations", "version": "0.0.1"}</customFields>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/application-json-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
                <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
                <totalSizeCap>2GB</totalSizeCap>
            </rollingPolicy>
        </appender>

        <!-- Audit Log Appender -->
        <appender name="AUDIT_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/audit.log</file>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <charset>${LOG_CHARSET}</charset>
                <customFields>{"log_type": "audit"}</customFields>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/audit-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
                <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            </rollingPolicy>
        </appender>

        <!-- Performance Log Appender -->
        <appender name="PERFORMANCE_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/performance.log</file>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <charset>${LOG_CHARSET}</charset>
                <customFields>{"log_type": "performance"}</customFields>
            </encoder>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/archive/performance-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_FILE_MAX_SIZE}</maxFileSize>
                <maxHistory>${LOG_FILE_MAX_HISTORY}</maxHistory>
            </rollingPolicy>
        </appender>

        <!-- Async Appenders for production -->
        <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="FILE"/>
        </appender>

        <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="JSON_FILE"/>
        </appender>

        <appender name="ASYNC_AUDIT" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="AUDIT_LOG"/>
        </appender>

        <appender name="ASYNC_PERFORMANCE" class="ch.qos.logback.classic.AsyncAppender">
            <queueSize>512</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <appender-ref ref="PERFORMANCE_LOG"/>
        </appender>

        <!-- Logger configuration for production -->
        <logger name="cn.gaifan.douyinOperations.common.aspect.AuditLogAspect" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_AUDIT"/>
        </logger>

        <logger name="cn.gaifan.douyinOperations.common.aspect.PerformanceLogAspect" level="INFO" additivity="false">
            <appender-ref ref="ASYNC_PERFORMANCE"/>
        </logger>

        <logger name="cn.gaifan.douyinOperations" level="INFO"/>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.hibernate" level="WARN"/>

        <!-- Root logger for production -->
        <root level="INFO">
            <appender-ref ref="ASYNC_FILE"/>
            <appender-ref ref="ASYNC_JSON"/>
        </root>
    </springProfile>
</configuration>
