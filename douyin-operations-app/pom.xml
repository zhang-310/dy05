    <groupId>cn.gaifan</groupId>
    <artifactId>douyin-operations-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>douyin-operations-app</name>
    <description>抖音运营后台（可执行 Spring Boot 应用）</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.0.0-M4</spring-ai.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.skip>false</jacoco.skip>
    </properties>

    <dependencies>

        <dependency>
            <groupId>cn.gaifan</groupId>
            <artifactId>douyin-operations-contract</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.gaifan</groupId>
            <artifactId>douyin-operations-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.gaifan</groupId>
            <artifactId>douyin-operations-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.gaifan</groupId>
            <artifactId>douyin-operations-integration</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.gaifan</groupId>
            <artifactId>douyin-operations-asset</artifactId>
