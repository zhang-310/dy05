{
  "name": "dy02-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:pages:stable": "vitest run src/pages src/router/__tests__/talentShortvideoEntry.test.tsx --pool forks --no-file-parallelism --testTimeout 20000 --hookTimeout 20000",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:autofix": "playwright test e2e/tests/autofix.spec.ts --project=chromium-autofix",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen http://localhost:3000"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.4.0",
    "@mui/material": "^6.4.0",
    "@mui/x-data-grid": "^7.28.0",
    "@mui/x-tree-view": "^8.27.2",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.64.2",
    "@testing-library/react": "^16.3.2",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "i18next": "^26.0.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "notistack": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^17.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.2",
    "react-window": "^2.2.7",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.59.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.11",
    "vitest": "^2.1.9"
  }
}
