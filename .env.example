# ============================================================
# Docker Environment Variables Configuration
# Copy this file to .env.local for local development
# ============================================================

# ============================================================
# Database Configuration
# ============================================================
DB_USER=postgres
DB_PASSWORD=postgresql
DB_NAME=douyin_operations
DB_PORT=5432

# ============================================================
# Redis Configuration
# ============================================================
REDIS_PORT=6379

# ============================================================
# Backend Service Configuration
# ============================================================
BACKEND_PORT=8080
SPRING_PROFILE=docker
# 本地开发：后端端口（默认 8080）。勿设为 8188，会与 ComfyUI 默认端口冲突
# SERVER_PORT=8080

# ============================================================
# Frontend Service Configuration
# ============================================================
FRONTEND_PORT=80
VITE_API_URL=http://backend:8080

# ============================================================
# Java JVM Configuration (Optional)
# ============================================================
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0

# ============================================================
# AI / DeepSeek API Configuration
# ============================================================
# DeepSeek API Key（用于文本生成等，也可在「AI 管理→AI 模型管理」中配置）
DEEPSEEK_API_KEY=

# TianAPI（天聚数行）https://www.tianapi.com — 热搜/素材/内容审核等；复制到 .env 后填写
# TIANAPI_ENABLED=true
# TIANAPI_API_KEY=
# TIANAPI_BASE_URL=https://apis.tianapi.com
# TIANAPI_HOT_CACHE_MINUTES=5

# Kling（快手可灵）图生视频/文生图 API
# 官方平台 https://app.klingai.com 获取 Key 和 Secret
# 配置后文生图优先使用可灵（无需本地 Stable Diffusion）
KLING_API_KEY=
KLING_API_SECRET=
# 图片 API 地址，默认 https://api-beijing.klingai.com/v1/images
# KLING_API_URL=https://api-beijing.klingai.com/v1/images
# 视频 API 地址，默认 https://api-beijing.klingai.com/v1/videos
# KLING_VIDEO_API_URL=https://api-beijing.klingai.com/v1/videos

# MiniMax Hailuo 图生视频（国内直连，动作/舞蹈场景优选）
# 配置后 IntelligentModelRouter 可自动选择
# MINIMAX_API_KEY=
# MINIMAX_API_URL=https://api.minimax.io/v1

# Runway Gen-4 Turbo（海外中转，VFX/特效场景优选）
# RUNWAY_API_KEY=
# RUNWAY_API_URL=https://api.dev.runwayml.com/v1

# Luma Ray2/Ray3（海外中转，首尾帧控制，电影感强）
# LUMA_API_KEY=
# LUMA_API_URL=https://api.lumalabs.ai/dream-machine/v1

# FFmpeg 路径，首尾帧视频合成（Kling 失败时降级）需要。未安装时：winget install ffmpeg 或配置完整路径
FFMPEG_PATH=ffmpeg
# 爆款深度分析：本机下载/抽帧/ASR（需 Bean VideoAnalysisService）。默认 true；Docker 镜像内无 yt-dlp 时可设 false
VIDEO_ANALYSIS_ENABLED=true
# 口播 ASR：需本机可执行 whisper（PATH）；未安装时管线会降级为推演文案
WHISPER_ENABLED=true
YT_DLP_PATH=yt-dlp
# 抖音等站需登录态：导出浏览器 cookies 为 Netscape 格式 txt，填绝对路径（勿提交仓库）
# YT_DLP_COOKIES_FILE=C:/secrets/douyin-cookies.txt
# YT_DLP_COOKIES_FROM_BROWSER=chrome
# YT_DLP_FORCE_DIRECT_FOR_DOUYIN=false
# YT_DLP_IMPERSONATE_DOUYIN=chrome120
# 视频后期处理（降噪+锐化+调色），本地视频生成后自动应用
# VIDEO_POST_PROCESSING_ENABLED=true
# VIDEO_POST_PROCESSING_LUT=  # 可选：.cube LUT 文件路径
# VIDEO_CACHE_ENABLED=true    # Phase 4.2: 图生视频 Redis 缓存，相同输入秒返回
# 视频工作目录，Windows 建议设为 %TEMP%\video-analysis 或 C:\tmp\video-analysis
# VIDEO_ANALYSIS_WORK_DIR=/tmp/video-analysis
# 抖音 yt-dlp 长期报 Fresh cookies 时可临时跳过本机下载（深度分析将仅靠元数据+LLM）
# DOUYIN_SKIP_YT_DLP_DOWNLOAD=false

# ComfyUI 本地服务地址，配置后有人物/场景参考图时优先使用 ComfyUI 生成关键帧
# 默认 http://localhost:8188，也可在系统配置中设置 ai.comfyui.url
COMFYUI_URL=http://localhost:8188
# ComfyUI 模型名称，如 v1-5-pruned-ema.safetensors
COMFYUI_CHECKPOINT=

# 讯飞 TTS 语音合成（配置后优先使用讯飞，否则使用 TTS_URL 代理）
# 也可在系统配置中设置 ai.tts.iflytek.app-id / api-key / api-secret
IFLYTEK_APP_ID=17363d94
IFLYTEK_API_KEY=3c270b1d7690f25d4e9ddffc410cdded
IFLYTEK_API_SECRET=M2Q4NGY3MDk1YmY4MGVhNGZjNTAyNTk2

# ============================================================
# Security (必填：生产环境)
# ============================================================
# JWT Token 密钥，至少 32 字符，含大小写字母、数字、特殊字符
# 开发环境可用默认值；生产必须设置强密钥
APP_TOKEN_SECRET=dev-only-change-in-production-2025!@#$%

# ============================================================
# Application Configuration
# ============================================================
APP_NAME=Douyin Operations
APP_VERSION=1.0.0
LOG_LEVEL=INFO
