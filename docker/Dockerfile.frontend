# ============================================================
# 前端容器：React + MUI SPA
# 多阶段构建，Node 编译 + Nginx 静态服务
# ============================================================

# 阶段 1: Node.js 编译前端
FROM node:20-alpine AS frontend-builder

WORKDIR /app

# 复制 package.json 并安装依赖
COPY frontend-react/package.json frontend-react/package-lock.json* ./

RUN npm ci --prefer-offline --no-audit --no-fund

# 复制源码并构建（输出到 dist）
COPY frontend-react/ .

# 为生产环境构建
RUN npm run build

# ============================================================
# 阶段 2: Nginx 运行时
# ============================================================
FROM nginx:1.25-alpine

LABEL maintainer="gaifan" \
      description="Douyin Operations Frontend" \
      version="1.0.0"

# 安装工具
RUN apk add --no-cache curl bash

RUN addgroup -g 1001 appuser && adduser -u 1001 -G appuser -D appuser

WORKDIR /usr/share/nginx/html

# 复制构建产物到 Nginx 静态目录
COPY --from=frontend-builder /app/dist .

# 复制 Nginx 配置（SPA 路由、gzip 压缩、缓存控制）
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# 复制启动脚本
COPY docker/nginx/start.sh /app/start.sh
RUN chmod +x /app/start.sh

# 设置非 root 用户权限
RUN chown -R appuser:appuser /usr/share/nginx/html /var/cache/nginx /var/log/nginx /etc/nginx/conf.d \
    && touch /var/run/nginx.pid && chown appuser:appuser /var/run/nginx.pid

USER appuser

EXPOSE 80

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost/health || exit 1

CMD ["/app/start.sh"]
