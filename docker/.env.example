# ============================================================
# 抖音运营平台 Docker 部署配置
# 使用: cp .env.example .env 后按需修改
# ============================================================

# ----- 数据库 -----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgresql
POSTGRES_DB=douyin_operations
POSTGRES_PORT=5433

# ----- Redis -----
REDIS_PORT=6380

# ----- RabbitMQ -----
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ----- Elasticsearch -----
ES_PORT=9200

# ----- 应用端口 -----
APP_PORT=8189
NGINX_PORT=8888

# ----- MinIO（--profile ai-builtin 时 etcd/minio/milvus 需要；compose 已默认 minioadmin/minioadmin） -----
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin

# ----- Milvus 2.6.11（数据为空时可用 -v 删卷重建） -----
# 宿主机端口 19631，容器内通过 host.docker.internal 访问
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19631

# 自建 AI 时（--profile ai-builtin）本地后端连容器内 Milvus：
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# ----- 应用 -----
SPRING_PROFILE=prod
# 至少 32 字符，含大小写、数字、特殊字符；生产必须改为强密钥
APP_TOKEN_SECRET=defaultSecretKey2025ForDocker!@

# ----- Ollama（可选） -----
OLLAMA_URL=
