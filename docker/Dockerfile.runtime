# ============================================================
# 后端应用运行时镜像：使用本机 Maven 已打包的 Spring Boot JAR
# ============================================================
FROM mcr.microsoft.com/playwright/java:v1.49.0-noble

LABEL maintainer="gaifan" description="Douyin Operations Backend API Runtime"

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    fonts-liberation \
    fonts-noto-cjk \
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    tesseract-ocr-eng \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY douyin-operations-app/target/douyin-operations-app-*.jar app.jar

ENV JAVA_OPTS="-XX:+UseContainerSupport \
  -XX:MaxRAMPercentage=75.0 \
  -XX:InitialRAMPercentage=50.0 \
  -XX:+UseG1GC \
  -XX:MaxGCPauseMillis=200 \
  -Djava.security.egd=file:/dev/./urandom \
  -Dspring.lifecycle.timeout-per-shutdown-phase=30s"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
