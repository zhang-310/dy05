# Copy to .env on each remote collection server.
TZ=Asia/Shanghai

# Every collector must be unique across all Tencent Cloud servers.
# Recommended pattern: tencent-${region}-${index}, for example:
# tencent-shanghai-01 ... tencent-shanghai-10
COLLECTOR_WORKER_ID=tencent-shanghai-01
COLLECTOR_REGION=tencent-shanghai

# Master server API base URL. Use the public HTTPS nginx URL if available.
# The collector only calls /api/v1/short-video/account-collect/worker/* on this server.
SHORTVIDEO_ACCOUNT_COLLECT_MASTER_URL=https://your-master.example.com
SHORTVIDEO_ACCOUNT_COLLECT_REMOTE_WORKER_TOKEN=change-me-long-random-token

# Local cookie file on the collector server. Mount path is defined in docker-compose.collector.yml.
YT_DLP_COOKIES_FILE=/collector/cookies/douyin.txt

SHORTVIDEO_ACCOUNT_COLLECT_WORKER_LEASE_SECONDS=900
SHORTVIDEO_ACCOUNT_COLLECT_WORKER_POLL_MS=15000
SHORTVIDEO_ACCOUNT_COLLECT_WORKER_INITIAL_DELAY_MS=10000
SHORTVIDEO_ACCOUNT_COLLECT_WORKER_HEARTBEAT_MS=60000

ACCOUNT_COLLECT_PLAYWRIGHT_TIMEOUT_MS=60000
ACCOUNT_COLLECT_MAX_SCROLL_ROUNDS=80
ACCOUNT_COLLECT_SCROLL_MIN_ROUNDS=10
ACCOUNT_COLLECT_SCROLL_IDLE_STREAK_LIMIT=6
ACCOUNT_COLLECT_SCROLL_PAUSE_MS=2600
ACCOUNT_COLLECT_USER_PAGE_SETTLE_MS=5000
APP_LOG_LEVEL=INFO
