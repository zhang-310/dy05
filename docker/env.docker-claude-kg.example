# ============================================================
# Docker 部署：Claude 代理主模型 + 知识图谱
# 用法: cp env.docker-claude-kg.example .env
# ============================================================

# 数据库
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgresql
POSTGRES_DB=douyin_operations
POSTGRES_PORT=5433

# Redis / RabbitMQ
REDIS_PORT=6380
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672

# MinIO（ai-builtin 必填）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===== Claude 线上代理（质量优先）=====
# 代理地址：OpenAI 兼容 /v1/chat/completions，如 one-api、中转站等
OPENAI_URL=https://your-claude-proxy.com/v1
OPENAI_API_KEY=sk-your-proxy-api-key

# 若代理用 Anthropic 原生，可单独配置：
# ANTHROPIC_API_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-xxx

# ===== 知识图谱（Neo4j）=====
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/password

# ===== Milvus 向量库 =====
MILVUS_ENABLED=true
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ===== Embedding（知识库检索，可选本地 Ollama）=====
# 主模型用 Claude 代理；Embedding 仍可用本地 Ollama
OLLAMA_URL=http://host.docker.internal:11434
# 若无本地 Ollama，可设空，知识库将降级或需配置云端 Embedding

# ===== 行业大脑 =====
AI_BRAIN_ENABLED=true
AI_BRAIN_KG_ENABLED=true

# ===== 安全 =====
APP_TOKEN_SECRET=prod-change-me-at-least-32-chars!@#
